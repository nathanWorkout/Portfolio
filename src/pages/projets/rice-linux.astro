---
import ProjectPageLayout from '../../components/ProjectPageLayout.astro';
import RiceLinux from '../../components/projects/RiceLinux.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<ProjectPageLayout
  title="VaultRice"
  previous={{ href: `${base}projets/cpu-8-bits/`, label: 'CPU 8 bits' }}
  next={{ href: `${base}reseaux/`, label: 'Mes réseaux' }}
>
  <RiceLinux />
</ProjectPageLayout>

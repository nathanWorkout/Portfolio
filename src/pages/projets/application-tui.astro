---
import ProjectPageLayout from '../../components/ProjectPageLayout.astro';
import ApplicationTui from '../../components/projects/ApplicationTui.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<ProjectPageLayout
  title="Application TUI"
  previous={{ href: `${base}projets/analyse-kernel-linux/`, label: 'Analyse du kernel Linux' }}
  next={{ href: `${base}reseaux/`, label: 'Mes réseaux' }}
>
  <ApplicationTui />
</ProjectPageLayout>

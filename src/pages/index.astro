---
import '../styles/global.css';
import '../styles/hero.css';
import Layout from '../layouts/layout.astro';
import PortfolioSidebar from '../components/PortfolioSidebar.astro';

const assetBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Portfolio">
  <div class="page">
    <PortfolioSidebar />

    <section id="hero" style={`--circuit-image: url('${assetBase}img/circuit_board.png')`}>
      <p id="intro">
        <span>Je construis</span>
        <span>des systèmes</span>
        <span>de zéro.</span>
      </p>
    </section>
  </div>
</Layout>

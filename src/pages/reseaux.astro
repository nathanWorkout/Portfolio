---
import '../styles/global.css';
import '../styles/projects.css';
import Layout from '../layouts/layout.astro';
import PortfolioSidebar from '../components/PortfolioSidebar.astro';
import PagePagination from '../components/PagePagination.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Mes réseaux - Portfolio">
  <div class="page">
    <PortfolioSidebar />
    <main class="projects-page">
      <section id="tiktok" class="project-section">
        <p class="eyebrow">Mes réseaux / 01</p>
        <h1>TikTok</h1>

        <div class="project-description">
          <img
            class="project-media project-article-image"
            src={`${base}img/tiktok.png`}
            alt="Compte TikTok de Nathan"
          />
          <p>
            J’aime partager mes créations avec d’autres passionnés, c’est pourquoi
            j’ai ouvert un compte sur ce réseau social. J’y publie principalement
            l’avancée, les mises à jour et les difficultés rencontrées sur mon système
            d’exploitation, mais c’est aussi pour moi un moyen de découvrir de
            nouveaux projets et de nouvelles idées.
          </p>
        </div>
      </section>

    </main>
    <PagePagination
      previous={{ href: `${base}projets/`, label: 'Mes projets' }}
      next={{ href: base, label: 'Accueil' }}
    />
  </div>
</Layout>

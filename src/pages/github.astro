---
import '../styles/global.css';
import '../styles/projects.css';
import Layout from '../layouts/layout.astro';
import PortfolioSidebar from '../components/PortfolioSidebar.astro';
import PagePagination from '../components/PagePagination.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="GitHub - Portfolio">
  <div class="page">
    <PortfolioSidebar />
    <main class="projects-page">
      <section class="project-section">
        <p class="eyebrow">Mes réseaux / 02</p>
        <h1>GitHub</h1>

        <div class="project-description">
          <a href="https://github.com/nathanWorkout" target="_blank" rel="noopener noreferrer">
            <img
              class="project-media project-article-image"
              src={`${base}img/github.png`}
              alt="Profil GitHub de Nathan"
            />
          </a>
          <p>
            J’utilise GitHub pour versionner mes projets et rendre publics, en open source,
            les plus importants, comme{' '}
            <a
              class="project-inline-link"
              href="https://github.com/nathanWorkout/VaultOs"
              target="_blank"
              rel="noopener noreferrer"
            >
              VaultOS
            </a>,
            mon système d’exploitation 64 bits. On y retrouve aussi VaultLang, mon langage
            de programmation bas niveau, et VaultRice, ma configuration Hyprland.
          </p>
        </div>
      </section>
    </main>
    <PagePagination
      previous={{ href: `${base}reseaux/`, label: 'Mes réseaux' }}
      next={{ href: base, label: 'Accueil' }}
    />
  </div>
</Layout>

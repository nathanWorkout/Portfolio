---
import '../styles/global.css';
import '../styles/projects.css';
import Layout from '../layouts/layout.astro';
import PortfolioSidebar from '../components/PortfolioSidebar.astro';
import PagePagination from '../components/PagePagination.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Mes projets - Portfolio">
  <div class="page">
    <PortfolioSidebar />
    <main class="projects-page projects-index">
      <section class="project-section">
        <p class="eyebrow">Portfolio / Projets</p>
        <h1>Mes projets</h1>
        <p class="project-index-intro">
          Explore les projets qui construisent mon parcours, du matériel au système
          d’exploitation.
        </p>
      </section>
    </main>
    <PagePagination
      previous={{ href: `${base}histoire/`, label: 'Mon histoire' }}
      next={{ href: `${base}reseaux/`, label: 'Mes réseaux' }}
    />
  </div>
</Layout>
